# ---- Backend (SERVER ONLY, no NEXT_PUBLIC_ prefix) --------------------
# The real backend base URL. It is read on the server only, so the backend
# host never reaches the browser bundle. The build FAILS when it is missing.
BACKEND_API_URL=https://your-backend.example.com/api/v1

# Fallback used ONLY outside production (local development).
# BACKEND_LOCAL_API_URL=http://localhost:5000/api/v1

# Optional JSON map of server-side route overrides:
# { "/old/path": "/new/path" }
# API_ROUTE_MAP=

# ---- Data mode ---------------------------------------------------------
NEXT_PUBLIC_DATA_MODE=api_only
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_HOMEPAGE_SNAPSHOT=false
# ---- Debug -------------------------------------------------------------
NEXT_PUBLIC_DEBUG_MOVIES=false
# ---- Runtime -----------------------------------------------------------
NEXT_PUBLIC_LOCALE=vi
NEXT_PUBLIC_API_TIMEOUT=8000
NEXT_PUBLIC_HERO_AUTOPLAY_INTERVAL=6000
NEXT_PUBLIC_HERO_DESC_LIMIT=220
NEXT_PUBLIC_WS_ENABLED=false
# ---- NextAuth ----------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# ---- Google OAuth ------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ---- Facebook OAuth ----------------------------------------------------
FACEBOOK_ID=
FACEBOOK_SECRET=
# ---- TMDB --------------------------------------------------------------
NEXT_PUBLIC_TMDB_API_KEY=
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_AUTH_TOKEN=
# ---- RestCountries (server-only) --------------------------------------
RESTCOUNTRIES_API_URL=https://api.restcountries.com/countries/v5
RESTCOUNTRIES_API_TOKEN=

BACKEND_TLS_MAX_VERSION=TLSv1.2
